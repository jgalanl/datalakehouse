# --- Almacenamiento: MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Gobernanza: OpenMetadata ---
DB_USER=
DB_USER_PASSWORD=
DB_HOST=
DB_PORT=
OM_DATABASE=

# Usuario administrador de OpenMetadata = {principal}@{domain}.
AUTHORIZER_ADMIN_PRINCIPALS=
AUTHORIZER_PRINCIPAL_DOMAIN=

# Claves de seguridad de OpenMetadata
JWT_ISSUER=
JWT_KEY_ID=
FERNET_KEY=

# JWT del ingestion-bot — lo usa config/openmetadata/run_ingestion.sh para autenticar
# los flujos de ingesta contra el servidor de OpenMetadata. Se copia desde la UI
# (Settings > Bots > ingestion-bot) o con GET /api/v1/bots/ingestion-bot.
# Se invalida al recrear el volumen de openmetadata-postgres: hay que volver a copiarlo.
OM_INGESTION_BOT_JWT=

# --- Operaciones de ML: MLflow ---
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=

# Modelo servido por el perfil `api` (docker compose --profile api up -d model-server).
SERVE_MODEL=fare_prediction
SERVE_ALIAS=champion
