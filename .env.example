# ============================================================================
# STORAGE LAYER - MinIO
# ============================================================================
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ============================================================================
# DATA GOVERNANCE LAYER - OpenMetadata
# ============================================================================
DB_USER=
DB_USER_PASSWORD=
DB_HOST=
DB_PORT=
OM_DATABASE=

# OpenMetadata admin login = {principal}@{domain}.
AUTHORIZER_ADMIN_PRINCIPALS=
AUTHORIZER_PRINCIPAL_DOMAIN=

# OpenMetadata security keys
JWT_ISSUER=
JWT_KEY_ID=
FERNET_KEY=

# Ingestion-bot JWT — used by config/openmetadata/run_ingestion.sh to authenticate
# the metadata ingestion workflow against the OM server. Copy it from the OM UI
# (Settings > Bots > ingestion-bot) or GET /api/v1/bots/ingestion-bot.
OM_INGESTION_BOT_JWT=

# ============================================================================
# ML OPERATIONS LAYER - MLflow
# ============================================================================
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=

# Model served by the `api` profile (docker compose --profile api up -d model-server).
SERVE_MODEL=fare_predition
SERVE_ALIAS=
